<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>LunesFC — Fútbol entre amigos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg:      #080b10;
  --surface: #0f1520;
  --surf2:   #161d2e;
  --border:  #1e2a40;
  --accent:  #00d4ff;
  --accent2: #ff6b00;
  --green:   #00e676;
  --yellow:  #ffd600;
  --orange:  #ff6d00;
  --purple:  #b46bff;
  --text:    #e8f0fe;
  --muted:   #5a6a8a;
  --tab-h:   64px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:'Rajdhani',sans-serif;background:var(--bg);color:var(--text);-webkit-tap-highlight-color:transparent;overscroll-behavior:none}
button{cursor:pointer;border:none;background:none;font-family:inherit}
input,select,textarea{font-family:inherit}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}

/* APP SHELL */
#app{height:100dvh;display:flex;flex-direction:column}
.screen{display:none;flex-direction:column;height:100%}
.screen.active{display:flex}

/* AUTH */
#auth-screen{background:radial-gradient(ellipse at 50% 0%,#0a1628,#080b10 60%);align-items:center;justify-content:center;padding:24px;overflow-y:auto}
.auth-logo{text-align:center;margin-bottom:32px}
.auth-logo .brand{font-family:'Bebas Neue',sans-serif;font-size:56px;letter-spacing:4px;background:linear-gradient(135deg,var(--accent),#0077ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1}
.auth-logo .tagline{font-size:13px;color:var(--muted);letter-spacing:3px;text-transform:uppercase;margin-top:4px}
.auth-ball{font-size:56px;margin-bottom:8px;display:block}
.auth-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px;width:100%;max-width:400px;box-shadow:0 24px 60px rgba(0,0,0,.5)}
.auth-tabs{display:flex;margin-bottom:24px;border-bottom:1px solid var(--border)}
.auth-tab{flex:1;padding:12px;text-align:center;font-size:15px;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;transition:all .2s;letter-spacing:1px;text-transform:uppercase}
.auth-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.auth-form{display:none}.auth-form.active{display:block}

/* FORMS */
.form-group{margin-bottom:16px}
.form-label{display:block;font-size:12px;color:var(--muted);margin-bottom:6px;letter-spacing:1px;text-transform:uppercase}
.form-input{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:15px;transition:border-color .2s;-webkit-appearance:none}
.form-input:focus{outline:none;border-color:var(--accent)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-error{color:#ff4d4d;font-size:13px;margin-top:8px;display:none}
.form-error.show{display:block}

/* BUTTONS */
.btn-primary{width:100%;padding:14px;border-radius:10px;background:linear-gradient(135deg,var(--accent),#0077ff);color:#000;font-size:15px;font-weight:700;letter-spacing:1px;text-transform:uppercase;transition:opacity .2s;margin-top:8px}
.btn-primary:active{opacity:.8}
.btn-secondary{width:100%;padding:12px;border-radius:10px;background:transparent;border:1px solid var(--border);color:var(--text);font-size:14px;font-weight:600;transition:border-color .2s}
.btn-secondary:active{border-color:var(--accent)}
.btn-danger{width:100%;padding:12px;border-radius:10px;background:transparent;border:1px solid #ff4d4d44;color:#ff6b6b;font-size:14px;font-weight:600;margin-top:8px}

/* MAIN */
#main-screen{background:var(--bg)}
.main-content{flex:1;overflow-y:auto;overflow-x:hidden;padding:16px 16px calc(var(--tab-h) + 16px);-webkit-overflow-scrolling:touch}

/* BOTTOM TABS */
.tab-bar{height:var(--tab-h);background:var(--surface);border-top:1px solid var(--border);display:flex;align-items:stretch;flex-shrink:0;padding-bottom:env(safe-area-inset-bottom)}
.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:var(--muted);font-size:9px;font-weight:600;letter-spacing:.3px;text-transform:uppercase;padding:6px 2px;position:relative;transition:color .2s}
.tab-item.active{color:var(--accent)}
.tab-item.active::before{content:'';position:absolute;top:0;left:15%;right:15%;height:2px;background:var(--accent);border-radius:0 0 3px 3px}
.tab-icon{font-size:20px;line-height:1}
.tab-badge{position:absolute;top:6px;right:calc(50% - 16px);background:#ff4d4d;color:#fff;font-size:9px;font-weight:700;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 3px}

/* GROUP SCREEN */
#group-screen{align-items:center;justify-content:flex-start;padding:24px;background:var(--bg);overflow-y:auto}
.group-screen-logo{font-family:'Bebas Neue',sans-serif;font-size:42px;letter-spacing:3px;color:var(--accent);text-align:center;margin-bottom:8px;width:100%;max-width:400px}
.group-screen-sub{color:var(--muted);font-size:14px;text-align:center;margin-bottom:24px;width:100%;max-width:400px}
.group-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:20px;width:100%;max-width:400px;margin-bottom:14px}
.group-card h3{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:var(--accent);margin-bottom:14px}
.group-item{display:flex;align-items:center;justify-content:space-between;padding:14px;background:var(--bg);border:1px solid var(--border);border-radius:10px;margin-bottom:8px;cursor:pointer;transition:border-color .2s}
.group-item:active{border-color:var(--accent)}
.btn-logout{background:transparent;color:var(--muted);font-size:13px;padding:6px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:20px;align-self:flex-end}

/* PAGE HEADER */
.page-header{display:flex;align-items:center;justify-content:space-between;padding:14px 0 16px}
.page-title{font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:2px;background:linear-gradient(135deg,var(--text),var(--muted));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.page-subtitle{font-size:13px;color:var(--muted);margin-top:2px}

/* SECTION TITLE */
.section-title{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px;color:var(--muted);margin:18px 0 10px;display:flex;align-items:center;gap:8px}
.section-title::after{content:'';flex:1;height:1px;background:var(--border)}

/* PLAYER CARDS */
.players-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(148px,1fr));gap:12px}
.player-card{background:linear-gradient(145deg,var(--surf2),var(--surface));border:1px solid var(--border);border-radius:14px;padding:14px 12px;cursor:pointer;transition:transform .15s;position:relative;overflow:hidden}
.player-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),transparent)}
.player-card:active{transform:scale(.97)}
.player-card-overall{font-family:'Bebas Neue',sans-serif;font-size:40px;line-height:1;text-align:center;margin-bottom:2px}
.player-card-pos{font-size:10px;color:var(--muted);text-align:center;text-transform:uppercase;letter-spacing:1px}
.player-card-name{font-weight:700;font-size:14px;text-align:center;margin:6px 0 2px;line-height:1.2}
.player-card-sub{font-size:11px;color:var(--muted);text-align:center}
.player-card-foot{position:absolute;top:8px;right:8px;font-size:10px;font-weight:700;color:var(--muted);background:var(--border);border-radius:4px;padding:2px 5px}
.player-card-photo{width:56px;height:56px;border-radius:50%;margin:0 auto 6px;display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:22px;color:#000;background:linear-gradient(135deg,var(--accent),#0077ff);overflow:hidden;flex-shrink:0}
.player-card-photo img{width:100%;height:100%;object-fit:cover}
.confirmed-dot{position:absolute;bottom:8px;right:8px;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green)}
.mvp-crown{position:absolute;top:6px;left:8px;font-size:14px}
.streak-badge{position:absolute;bottom:8px;left:8px;font-size:10px;font-weight:700;color:var(--orange);background:rgba(255,109,0,.15);border-radius:4px;padding:2px 5px}

/* STAT BARS */
.stat-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.stat-bar-label{font-size:12px;color:var(--muted);width:78px;flex-shrink:0;letter-spacing:.5px;text-transform:uppercase}
.stat-bar-track{flex:1;height:6px;background:var(--border);border-radius:3px;overflow:hidden}
.stat-bar-fill{height:100%;border-radius:3px;transition:width .5s ease}
.stat-bar-fill.elite{background:linear-gradient(90deg,#ffd600,#ffab00)}
.stat-bar-fill.good{background:linear-gradient(90deg,#00e676,#00bfa5)}
.stat-bar-fill.avg{background:linear-gradient(90deg,#ff6d00,#e65100)}
.stat-bar-val{font-size:13px;font-weight:700;width:28px;text-align:right}

/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);display:flex;align-items:flex-end;justify-content:center;z-index:100;opacity:0;pointer-events:none;transition:opacity .25s}
.modal-overlay.open{opacity:1;pointer-events:auto}
.modal-sheet{background:var(--surface);border-radius:20px 20px 0 0;width:100%;max-width:480px;max-height:90dvh;overflow-y:auto;transform:translateY(60px);transition:transform .3s cubic-bezier(.32,1.28,.65,1)}
.modal-overlay.open .modal-sheet{transform:translateY(0)}
.modal-handle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:12px auto 0}
.modal-body{padding:16px 20px 40px}
.modal-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:2px;margin-bottom:4px}
.modal-subtitle{font-size:13px;color:var(--muted);margin-bottom:18px}
.modal-close{position:absolute;top:14px;right:16px;color:var(--muted);font-size:24px;width:32px;height:32px;display:flex;align-items:center;justify-content:center}
.modal-header-rel{position:relative}

/* SLIDER */
.slider-group{margin-bottom:18px}
.slider-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.slider-label{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:1px}
.slider-value{font-family:'Bebas Neue',sans-serif;font-size:22px}
.slider-input{-webkit-appearance:none;width:100%;height:6px;border-radius:3px;outline:none;cursor:pointer;background:var(--border)}
.slider-input::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px rgba(0,212,255,.5);cursor:pointer}

/* ATTENDANCE */
.attendance-list{display:flex;flex-direction:column;gap:8px}
.attendance-item{display:flex;align-items:center;justify-content:space-between;background:var(--surf2);border:1px solid var(--border);border-radius:12px;padding:12px}
.att-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#0077ff);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:17px;color:#000;flex-shrink:0;overflow:hidden}
.att-avatar img{width:100%;height:100%;object-fit:cover}
.att-toggle{padding:7px 14px;border-radius:20px;font-size:13px;font-weight:700;border:1px solid;transition:all .2s}
.att-toggle.confirmed{background:rgba(0,230,118,.15);border-color:var(--green);color:var(--green)}
.att-toggle.absent{background:transparent;border-color:var(--border);color:var(--muted)}
.att-toggle.mine{background:linear-gradient(135deg,var(--accent),#0077ff);border-color:transparent;color:#000}

/* TEAMS */
.teams-container{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.team-card{background:var(--surf2);border:1px solid var(--border);border-radius:14px;padding:12px}
.team-name{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1px}
.team-overall{font-family:'Bebas Neue',sans-serif;font-size:26px;color:var(--yellow)}
.team-player{display:flex;align-items:center;gap:6px;margin-bottom:6px}
.team-player-num{width:18px;height:18px;border-radius:50%;background:var(--border);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;flex-shrink:0}
.draw-btn{width:100%;padding:16px;border-radius:12px;margin-bottom:10px;background:linear-gradient(135deg,var(--accent2),#ff4500);color:#fff;font-size:16px;font-weight:700;letter-spacing:2px;text-transform:uppercase}
.draw-btn:active{opacity:.85}
.redraw-btn{width:100%;padding:11px;border-radius:12px;background:transparent;border:1px solid var(--border);color:var(--muted);font-size:14px;font-weight:600;letter-spacing:1px;text-transform:uppercase}
.confirmed-count{text-align:center;padding:12px;background:var(--surf2);border-radius:10px;margin-bottom:14px;border:1px solid var(--border)}
.confirmed-count .count{font-family:'Bebas Neue',sans-serif;font-size:40px;color:var(--accent)}
.confirmed-count .label{font-size:13px;color:var(--muted);letter-spacing:1px}

/* HISTORY */
.history-item{background:var(--surf2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-bottom:10px}
.history-date{font-size:12px;color:var(--muted);margin-bottom:8px;letter-spacing:1px}
.history-teams{display:flex;gap:8px;align-items:center;justify-content:center}
.history-team{text-align:center}
.history-team-name{font-weight:700;font-size:14px}
.history-team-ovr{font-family:'Bebas Neue',sans-serif;font-size:28px;color:var(--yellow)}
.history-vs{color:var(--muted);font-size:20px;font-weight:700}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}
.stat-card{background:var(--surf2);border:1px solid var(--border);border-radius:12px;padding:14px;text-align:center}
.stat-card .val{font-family:'Bebas Neue',sans-serif;font-size:34px;color:var(--accent)}
.stat-card .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px}

/* CHAT */
.chat-messages{display:flex;flex-direction:column;gap:8px;margin-bottom:12px;min-height:80px}
.chat-msg{max-width:85%;padding:10px 14px;border-radius:14px;font-size:14px;line-height:1.4}
.chat-msg.mine{align-self:flex-end;background:linear-gradient(135deg,rgba(0,212,255,.2),rgba(0,119,255,.2));border:1px solid rgba(0,212,255,.25)}
.chat-msg.other{align-self:flex-start;background:var(--surf2);border:1px solid var(--border)}
.chat-msg-author{font-size:11px;color:var(--muted);margin-bottom:3px;font-weight:600}
.chat-msg-text{color:var(--text)}
.chat-msg-time{font-size:10px;color:var(--muted);text-align:right;margin-top:3px}
.chat-input-row{display:flex;gap:8px;align-items:flex-end}
.chat-input{flex:1;padding:10px 14px;background:var(--surf2);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:14px;resize:none;max-height:80px}
.chat-input:focus{outline:none;border-color:var(--accent)}
.chat-send{width:44px;height:44px;border-radius:12px;background:linear-gradient(135deg,var(--accent),#0077ff);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.chat-send:active{opacity:.8}

/* MVP */
.mvp-vote-item{display:flex;align-items:center;gap:12px;padding:12px;background:var(--surf2);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;cursor:pointer;transition:border-color .2s}
.mvp-vote-item.selected{border-color:var(--yellow);background:rgba(255,214,0,.07)}
.mvp-vote-item:active{border-color:var(--accent)}
.mvp-star{font-size:24px;opacity:.3;transition:opacity .2s}
.mvp-vote-item.selected .mvp-star{opacity:1}
.mvp-vote-name{font-weight:700;font-size:15px}
.mvp-vote-sub{font-size:12px;color:var(--muted)}
.mvp-result-bar{height:8px;border-radius:4px;background:linear-gradient(90deg,var(--yellow),var(--orange));margin-top:4px;transition:width .5s ease}

/* PROFILE PHOTO */
.photo-upload-area{width:100px;height:100px;border-radius:50%;background:var(--surf2);border:2px dashed var(--border);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;cursor:pointer;position:relative;overflow:hidden;flex-shrink:0}
.photo-upload-area img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.photo-upload-area .upload-icon{position:absolute;font-size:28px;opacity:.6}
.photo-upload-area input{position:absolute;inset:0;opacity:0;cursor:pointer}

/* CHIPS */
.chip{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;letter-spacing:.5px}
.chip-green{background:rgba(0,230,118,.15);color:var(--green)}
.chip-orange{background:rgba(255,109,0,.15);color:var(--orange)}
.chip-blue{background:rgba(0,212,255,.15);color:var(--accent)}
.chip-purple{background:rgba(180,107,255,.15);color:var(--purple)}
.chip-yellow{background:rgba(255,214,0,.15);color:var(--yellow)}

/* NOTIF TOGGLE */
.notif-row{display:flex;align-items:center;justify-content:space-between;padding:14px;background:var(--surf2);border:1px solid var(--border);border-radius:12px;margin-bottom:8px}
.notif-toggle{width:44px;height:24px;background:var(--border);border-radius:12px;position:relative;cursor:pointer;transition:background .2s}
.notif-toggle.on{background:var(--accent)}
.notif-toggle::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .2s}
.notif-toggle.on::after{left:22px}

/* POSITION BADGE */
.pos-badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;letter-spacing:1px}
.pos-DL{background:rgba(0,230,118,.2);color:var(--green)}
.pos-MC{background:rgba(0,212,255,.2);color:var(--accent)}
.pos-DF{background:rgba(255,109,0,.2);color:var(--orange)}
.pos-PT{background:rgba(180,107,255,.2);color:var(--purple)}
.pos-EX{background:rgba(255,214,0,.2);color:var(--yellow)}

/* GROUP HEADER */
.group-header{background:var(--surf2);border-radius:12px;padding:12px 14px;margin-bottom:14px;border:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.group-header-name{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:2px}
.group-header-code{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:3px;color:var(--yellow);cursor:pointer}

/* USER PILL */
.user-pill{display:flex;align-items:center;gap:8px;background:var(--surf2);border:1px solid var(--border);border-radius:20px;padding:5px 10px;cursor:pointer}
.user-pill-avatar{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#0077ff);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#000;overflow:hidden}
.user-pill-avatar img{width:100%;height:100%;object-fit:cover}

/* EMPTY STATE */
.empty-state{text-align:center;padding:36px 20px;color:var(--muted)}
.empty-state .icon{font-size:44px;margin-bottom:10px}
.empty-state .msg{font-size:15px}

/* TOAST */
.toast{position:fixed;bottom:calc(var(--tab-h) + 12px);left:50%;transform:translateX(-50%) translateY(20px);background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 20px;font-size:14px;font-weight:600;color:var(--text);opacity:0;transition:all .3s;z-index:200;white-space:nowrap;box-shadow:0 8px 24px rgba(0,0,0,.4)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* RATE HEADER */
.rate-player-header{display:flex;align-items:center;gap:12px;margin-bottom:18px;background:var(--surf2);border-radius:12px;padding:12px;border:1px solid var(--border)}
.rate-avatar{width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#0077ff);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:21px;color:#000;flex-shrink:0;overflow:hidden}
.rate-avatar img{width:100%;height:100%;object-fit:cover}

@media(min-width:480px){.players-grid{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
<body>
<div id="app">

<!-- AUTH -->
<div id="auth-screen" class="screen active">
  <div class="auth-logo">
    <span class="auth-ball">⚽</span>
    <div class="brand">LunesFC</div>
    <div class="tagline">Fútbol entre amigos</div>
  </div>
