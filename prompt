      <div class="form-error" id="reg-error"></div>
      <button class="btn-primary" onclick="doRegister()">CREAR CUENTA</button>
    </div>
  </div>
</div>

<!-- GROUP SCREEN -->
<div id="group-screen" class="screen">
  <div style="width:100%;max-width:400px;display:flex;flex-direction:column;align-items:stretch;padding:24px;margin:0 auto;flex:1;overflow-y:auto">
    <button class="btn-logout" onclick="doLogout()" style="align-self:flex-end">Salir</button>
    <div class="group-screen-logo">LunesFC</div>
