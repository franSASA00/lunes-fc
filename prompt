<div class="toast" id="toast"></div>

<script>
/* ================================================================
   LUNESFC v2 — Con posiciones, MVP, chat, notificaciones, racha y foto
   ================================================================ */

const SKILLS = ['Ataque','Velocidad','Defensa','Precisión','Potencia','Resistencia'];
const POSITIONS = { DL:'Delantero', MC:'Mediocampista', DF:'Defensor', PT:'Portero', EX:'Extremo' };
const POS_ICONS  = { DL:'⚡', MC:'🔵', DF:'🛡️', PT:'🧤', EX:'⚽' };

// ── STORAGE ────────────────────────────────────────────────────
const DB = {
  get:(k,d=null)=>{ try{const v=localStorage.getItem('lfc2_'+k);return v?JSON.parse(v):d}catch{return d} },
  set:(k,v)=>localStorage.setItem('lfc2_'+k,JSON.stringify(v)),
  del:(k)=>localStorage.removeItem('lfc2_'+k),
};

// ── UTILS ──────────────────────────────────────────────────────
function simpleHash(s){ let h=5381; for(let i=0;i<s.length;i++) h=((h<<5)+h)^s.charCodeAt(i); return(h>>>0).toString(16).padStart(8,'0'); }
function genCode(){ const c='ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let r=''; for(let i=0;i<6;i++) r+=c[Math.floor(Math.random()*c.length)]; return r; }
function fmtTime(ts){ const d=new Date(ts); return d.toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'}); }
function fmtDate(ts){ return new Date(ts).toLocaleDateString('es-AR',{weekday:'long',day:'numeric',month:'long'}); }

// ── STATE ──────────────────────────────────────────────────────
let currentUser = DB.get('session',null);
let currentGroup = DB.get('currentGroup',null);
let currentTab = 'jugadores';
let currentTeams = null;
let pendingRateUid = null;
let rateSliders = {};
let selectedMvpUid = null;
let toastTimer;

// ── TOAST ──────────────────────────────────────────────────────
function showToast(msg,dur=2600){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),dur);
}

// ── MODAL ──────────────────────────────────────────────────────
function openModal(id){document.getElementById(id).classList.add('open')}
function closeModal(id){document.getElementById(id).classList.remove('open')}

// ── AUTH ───────────────────────────────────────────────────────
function switchAuthTab(tab){
  document.querySelectorAll('.auth-tab').forEach((el,i)=>el.classList.toggle('active',(i===0&&tab==='login')||(i===1&&tab==='register')));
  document.getElementById('login-form').classList.toggle('active',tab==='login');
  document.getElementById('register-form').classList.toggle('active',tab==='register');
}
function doRegister(){
  const nombre=document.getElementById('reg-nombre').value.trim();
  const apellido=document.getElementById('reg-apellido').value.trim();
  const email=document.getElementById('reg-email').value.trim().toLowerCase();
  const pass=document.getElementById('reg-pass').value;
  const edad=parseInt(document.getElementById('reg-edad').value);
  const pie=document.getElementById('reg-pie').value;
  const pos=document.getElementById('reg-pos').value;
  const errEl=document.getElementById('reg-error');
  if(!nombre||!apellido||!email||!pass||!edad||!pie){errEl.textContent='Completá todos los campos';errEl.classList.add('show');return}
  if(pass.length<6){errEl.textContent='Contraseña muy corta';errEl.classList.add('show');return}
  if(!email.includes('@')){errEl.textContent='Email inválido';errEl.classList.add('show');return}
  const users=DB.get('users',{});
  if(users[email]){errEl.textContent='Email ya registrado';errEl.classList.add('show');return}
  const uid='u_'+Date.now();
  users[email]={uid,nombre,apellido,email,passHash:simpleHash(pass),edad,pie,pos,photo:null,createdAt:Date.now()};
  DB.set('users',users);
  currentUser=users[email];
  DB.set('session',currentUser);
  errEl.classList.remove('show');
  showApp();
}
function doLogin(){
  const email=document.getElementById('login-email').value.trim().toLowerCase();
  const pass=document.getElementById('login-pass').value;
  const errEl=document.getElementById('login-error');
  const users=DB.get('users',{});
  const user=users[email];
  if(!user||user.passHash!==simpleHash(pass)){errEl.textContent='Email o contraseña incorrectos';errEl.classList.add('show');return}
  currentUser=user; DB.set('session',user); errEl.classList.remove('show'); showApp();
}
function doLogout(){
  currentUser=null; currentGroup=null;
  DB.del('session'); DB.del('currentGroup');
  showScreen('auth-screen');
}

// ── APP FLOW ───────────────────────────────────────────────────
function showApp(){
  if(!currentUser){showScreen('auth-screen');return}
  if(currentGroup) showMain(); else showGroupScreen();
}
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function showGroupScreen(){
  showScreen('group-screen');
  document.getElementById('group-welcome').textContent=`Hola, ${currentUser.nombre}! 👋`;
  renderMyGroups();
}
function showMain(){showScreen('main-screen');showTab(currentTab||'jugadores')}

// ── GROUPS ─────────────────────────────────────────────────────
function getGroups(){return DB.get('groups',{})}
function saveGroups(g){DB.set('groups',g)}
function getMyGroups(){const g=getGroups();return Object.values(g).filter(gr=>gr.members&&gr.members.includes(currentUser.uid))}
function renderMyGroups(){
  const list=document.getElementById('my-groups-list');
  const my=getMyGroups();
  if(!my.length){list.innerHTML='<div style="color:var(--muted);font-size:14px;text-align:center;padding:12px">Todavía no estás en ningún grupo</div>';return}
  list.innerHTML=my.map(g=>`
    <div class="group-item" onclick="enterGroup('${g.id}')">
      <div>
        <div style="font-weight:700;font-size:16px">${g.name}</div>
        <div style="font-size:12px;color:var(--muted)">Código: <b style="color:var(--yellow)">${g.code}</b> · ${g.members.length} jugador(es)</div>
      </div>
      <span style="color:var(--muted);font-size:20px">›</span>
    </div>`).join('');
}
function createGroup(){
  const name=document.getElementById('new-group-name').value.trim();
  if(!name){showToast('Ingresá un nombre');return}
  const groups=getGroups();
  const id='g_'+Date.now(); const code=genCode();
  groups[id]={id,name,code,members:[currentUser.uid],createdAt:Date.now(),history:[],chat:[]};
  saveGroups(groups);
  document.getElementById('new-group-name').value='';
  enterGroup(id);
}
function joinGroup(){
  const code=document.getElementById('join-code').value.trim().toUpperCase();
  if(code.length!==6){showToast('El código debe tener 6 caracteres');return}
  const groups=getGroups();
  const group=Object.values(groups).find(g=>g.code===code);
  if(!group){showToast('Código incorrecto');return}
  if(!group.members.includes(currentUser.uid)) group.members.push(currentUser.uid);
  saveGroups(groups);
  document.getElementById('join-code').value='';
  enterGroup(group.id);
}
function enterGroup(id){
  const groups=getGroups(); currentGroup=groups[id];
  DB.set('currentGroup',currentGroup); showMain();
}
function leaveGroupUI(){currentGroup=null;DB.del('currentGroup');showGroupScreen()}

// ── USERS ──────────────────────────────────────────────────────
function getUser(uid){const u=DB.get('users',{});return Object.values(u).find(x=>x.uid===uid)||null}
function saveUser(u){const users=DB.get('users',{});users[u.email]=u;DB.set('users',users);if(currentUser.uid===u.uid){currentUser=u;DB.set('session',u)}}
function getGroupMembers(){
  if(!currentGroup)return[];
  const g=getGroups()[currentGroup.id];
  if(!g)return[];
  return g.members.map(uid=>getUser(uid)).filter(Boolean);
}
function avatarEl(u,size=40,cls='att-avatar'){
  const s=size+'px';
  if(u&&u.photo) return `<div class="${cls}" style="width:${s};height:${s}"><img src="${u.photo}" alt="${u.nombre}"></div>`;
  const initials=u?`${u.nombre[0]}${u.apellido[0]}`:'?';
  return `<div class="${cls}" style="width:${s};height:${s}">${initials}</div>`;
}

// ── RATINGS ────────────────────────────────────────────────────
function getRatings(){return DB.get('ratings',{})}
function saveRatings(r){DB.set('ratings',r)}
function getPlayerStats(uid,gid){
  const r=getRatings(); const gR=(r[gid]||{})[uid]||{};
  const stats={};
  SKILLS.forEach(skill=>{
    const vals=Object.values(gR).map(x=>x[skill]).filter(v=>v!=null);
    stats[skill]=vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length):0;
  });
  const overall=SKILLS.length?Math.round(Object.values(stats).reduce((a,b)=>a+b,0)/SKILLS.length):0;
  return{stats,overall};
}

